# ─── Rust Game Server ───────────────────────────────────
RUST_SERVER_NAME=Rust Server
RUST_SERVER_IDENTITY=docker
RUST_SERVER_SEED=12345
RUST_SERVER_WORLDSIZE=3500
RUST_SERVER_MAXPLAYERS=100
RUST_SERVER_PORT=28015
RUST_SERVER_QUERYPORT=28017
RUST_RCON_PORT=28016
RUST_RCON_PASSWORD=changeme
RUST_RCON_WEB=1
RUST_APP_PORT=28082

# Steam Game Server Login Token (optional, from steamcommunity.com/dev/managegameservers)
RUST_SERVER_GSLT=

# Server presentation (optional - seed web admin defaults on first run)
RUST_SERVER_DESCRIPTION=
RUST_SERVER_URL=
RUST_SERVER_HEADERIMAGE=
RUST_SERVER_LOGOIMAGE=
RUST_SERVER_TAGS=

# Update check on start: 1 = compare the installed build id against the latest published
# build and update ONLY when a new one exists (no re-download/validate when already
# current); 0 = skip the check and boot the installed build.
RUST_UPDATE_ON_START=1
# Steam branch to track (default public). Beta branches also need a branch password.
RUST_BRANCH=public
# Force a full file re-validation/repair on the next start, then set back to 0. Use to fix
# a corrupt or half-applied install (SteamCMD "Error! App '258550' state is 0x6").
RUST_VALIDATE=0
# How many times to retry a failed SteamCMD update before falling back to the existing
# install. The retry path also self-heals a stale manifest (the "0x6" case).
RUST_UPDATE_MAX_ATTEMPTS=5

# Auto-update checker (runs in the web admin). Opt-in: periodically check for a newer Rust
# build and, when one appears, warn players in-game over RCON on a countdown, then restart
# to apply it (the entrypoint downloads it on boot). The dashboard shows the countdown and
# a Cancel button.
RUST_UPDATE_CHECK_ENABLED=0
# Minutes between checks.
RUST_UPDATE_CHECK_INTERVAL=15
# Minutes of player-warning countdown before the auto-restart (0 = restart immediately).
RUST_UPDATE_RESTART_DELAY=5

# Graceful-stop window (seconds) the web admin gives Rust to save before SIGKILL.
# Keep in sync with compose.yaml's stop_grace_period.
RUST_STOP_TIMEOUT=300

# uMod (Oxide) - set to 0 to disable
UMOD_ENABLED=1

# ─── Web Admin Dashboard ───────────────────────────────
WEB_PORT=3000
ADMIN_USER=admin
ADMIN_PASS=changeme
# Static bearer token for browser-less log access (e.g. piping prod logs into Claude Code):
#   curl -fsS -H "Authorization: Bearer $LOGS_API_TOKEN" https://host/api/server-logs.txt?tail=1000
# Leave empty to disable token access (browser session still required). Generate one with:
#   openssl rand -hex 32
LOGS_API_TOKEN=
